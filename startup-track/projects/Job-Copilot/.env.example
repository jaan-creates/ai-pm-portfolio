# Copy to .env and fill in. .env is gitignored — key values never enter the repo.
# The harness reads whichever key matches the model in config/harness.json.

# FREE default: Google Gemini (gemini-* models). Get a free key, no card, at
# https://aistudio.google.com/app/apikey  →  paste after the = below.
GEMINI_API_KEY=

# Optional: Anthropic (claude-* models), the paid/private judge. Pay-as-you-go.
ANTHROPIC_API_KEY=
