# --- Competitor autopsy clones (never commit) ---
_mined/

# --- Privacy: must never enter git history (Rev 3) ---
# Real resume — only resume.master.md (fake-data template) is committed.
resume.master.local.md
# Real operator config with comp floor etc. — only the .example is committed.
config/operator_overrides.json
# Secrets — ignore .env and any .env.<anything> (e.g. .env.local, .env.prod),
# but keep the committed template. Broad on purpose so a mis-named key file
# can't slip through.
.env
.env.*
!.env.example

# --- Harness runtime ---
harness/node_modules/
golden/results/*.json
!golden/results/.gitkeep
