# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC pepper used to verify capture-only iPhone Shortcut tokens.
CAPTURE_TOKEN_PEPPER=

# Paid providers are disabled until their feature flags are explicitly enabled.
FEATURE_OPENAI_ENRICHMENT=false
FEATURE_VIDEO_PROCESSING=false
FEATURE_X_API=false
OPENAI_API_KEY=
X_BEARER_TOKEN=
MEDIA_WORKER_URL=
MEDIA_WORKER_SIGNING_SECRET=

# Pilot budget controls, in Indian rupees.
MONTHLY_BUDGET_INR=2500
OPENAI_MONTHLY_BUDGET_INR=750
MEDIA_MONTHLY_BUDGET_INR=250
