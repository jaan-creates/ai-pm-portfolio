# .env.example
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
# `.env.example` IS committed so others know what variables exist.

# Required from Lesson 7 onward — your first API call
ANTHROPIC_API_KEY=

# Deferred to Phase 2 (Lesson 16) — second API for multi-vendor literacy
OPENAI_API_KEY=

# Deferred to Phase 1 Lesson 13 — open models and datasets
HUGGINGFACE_API_KEY=